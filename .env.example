# Every experiment is served below the Cramzz hub at /e/<slug>/.
CRAMZZ_BASE_PATH=/e/example-experiment/

# CI/release orchestration only. Keep unset for local builds; a release passes
# the exact 40-character source commit that dist/experiment.json must record.
EXPERIMENT_SOURCE_COMMIT=

# Optional public PostHog project token and approved US/EU ingestion origin.
# Production is network-silent unless both are present. Never put a secret in VITE_*.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
